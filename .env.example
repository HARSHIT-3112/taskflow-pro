# Copy this file to .env and fill in the values. Never commit .env.

# Postgres started by `docker compose up -d` at the repo root.
# Format is a SQLAlchemy URL: driver, credentials, host, port, database.
DATABASE_URL=postgresql+psycopg://taskflow:taskflow@localhost:5433/taskflow

# --- AI dependency suggestions (optional) ------------------------------------
# Set EITHER of these. With neither, the board is fully functional and the
# suggestion panel explains that the feature is unconfigured.
# Both keys are server-side only and are never sent to the browser.
#
# Gemini is used when both are present - its free tier makes the feature
# reproducible for anyone running this project.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Leave unset for local development: any loopback port is then
# allowed, so the board works whichever port Vite picks. For a deployment,
# set it to the real site origin (comma-separated for more than one):
# CORS_ORIGINS=https://taskflow.example.com
