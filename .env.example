# Copy to .env and fill in. Never commit .env.
# Local Postgres started by `docker compose up -d` (see docker-compose.yml).
DATABASE_URL="postgresql://taskflow:taskflow@localhost:5433/taskflow?schema=public"

# Optional. Without it the AI dependency-suggestion feature is disabled and the
# rest of the app runs normally. Server-side only, never exposed to the browser.
ANTHROPIC_API_KEY=
