// TaskFlow Pro data model.
//
// The dependency graph lives in the Dependency table: one row per directed edge.
// The engine (src/engine) is the only component that writes dates and
// dependencyState; nothing else may set them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The four Kanban columns. Workflow stage only - this says nothing about
/// whether a task is blocked. See DependencyState.
enum TaskStatus {
  BACKLOG
  IN_PROGRESS
  REVIEW
  DONE
}

/// Derived from the graph on every recompute, never set by hand.
/// READY   = every prerequisite is DONE
/// BLOCKED = at least one prerequisite is not DONE
enum DependencyState {
  READY
  BLOCKED
}

/// Who created a dependency edge. Keeps the graph auditable and lets us
/// measure how often AI suggestions survive human review.
enum DependencyOrigin {
  HUMAN
  AI_ACCEPTED
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String     @default("")
  status      TaskStatus @default(BACKLOG)

  /// Duration is the source of truth. endDate is always startDate + durationDays,
  /// computed by the engine, so the two can never disagree.
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  durationDays Int      @default(1)

  /// When true the engine treats startDate as a floor and will not schedule
  /// this task earlier, even if its prerequisites allow it.
  pinned Boolean @default(false)

  /// Fractional rank within a column, so inserting between two cards writes
  /// one row instead of renumbering the whole column.
  position Float

  /// Denormalised cache of the engine's verdict. Never an input to any
  /// decision - recomputing from the graph would give the same answer.
  dependencyState DependencyState @default(READY)

  /// Optimistic concurrency. Every write increments this; a write carrying a
  /// stale version is rejected rather than clobbering a newer plan.
  version Int @default(0)

  /// Which prerequisite actually determined this task's startDate. Lets the UI
  /// answer "why is this task on this date?" with the real reason.
  bindingConstraintId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Edges where this task is the prerequisite (tasks that wait on this one).
  dependents    Dependency[] @relation("UpstreamTask")
  /// Edges where this task is waiting (its own prerequisites).
  prerequisites Dependency[] @relation("DownstreamTask")

  suggestionsAsUpstream   Suggestion[] @relation("SuggestedUpstream")
  suggestionsAsDownstream Suggestion[] @relation("SuggestedDownstream")

  @@index([status, position])
}

/// One directed edge: upstream must finish before downstream can start.
model Dependency {
  id String @id @default(cuid())

  upstreamId   String
  downstreamId String

  /// Extra days of gap required between upstream finishing and downstream
  /// starting. 0 means downstream may start the next day.
  lagDays Int @default(0)

  origin DependencyOrigin @default(HUMAN)

  createdAt DateTime @default(now())

  upstream   Task @relation("UpstreamTask", fields: [upstreamId], references: [id], onDelete: Cascade)
  downstream Task @relation("DownstreamTask", fields: [downstreamId], references: [id], onDelete: Cascade)

  /// The same edge cannot be added twice.
  @@unique([upstreamId, downstreamId])
  /// Both directions are indexed: we walk the graph forwards (who depends on
  /// this?) and backwards (what does this wait on?) equally often.
  @@index([upstreamId])
  @@index([downstreamId])
}

/// An LLM-proposed edge awaiting human review. Deliberately a separate table
/// from Dependency: a suggestion is not part of the graph until a person
/// accepts it and it passes the engine's cycle check.
model Suggestion {
  id String @id @default(cuid())

  upstreamId   String
  downstreamId String

  /// Model's self-reported confidence, 0..1. Shown to the reviewer, never used
  /// to auto-accept anything.
  confidence Float

  /// Must quote evidence from the task text, so the reviewer judges the
  /// reasoning rather than the score.
  rationale String

  status SuggestionStatus @default(PENDING)

  createdAt DateTime @default(now())

  upstream   Task @relation("SuggestedUpstream", fields: [upstreamId], references: [id], onDelete: Cascade)
  downstream Task @relation("SuggestedDownstream", fields: [downstreamId], references: [id], onDelete: Cascade)

  @@unique([upstreamId, downstreamId])
  @@index([status])
}
